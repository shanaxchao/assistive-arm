<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro"
       name="six_dof_arm">

  <xacro:arg name="controller_yaml" default=""/>


  <!-- ========================================================= -->
  <!-- WORLD                                                     -->
  <!-- ========================================================= -->

  <link name="world"/>


  <!-- ========================================================= -->
  <!-- BASE                                                      -->
  <!-- ========================================================= -->

  <link name="base_link">

    <visual>
      <origin xyz="0 0 0.05"/>
      <geometry>
        <cylinder radius="0.10" length="0.10"/>
      </geometry>

      <material name="base_color">
        <color rgba="0.2 0.2 0.2 1"/>
      </material>
    </visual>

    <collision>
      <origin xyz="0 0 0.05"/>
      <geometry>
        <cylinder radius="0.10" length="0.10"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0.05"/>
      <mass value="2.0"/>
      <inertia
        ixx="0.01"
        ixy="0.0"
        ixz="0.0"
        iyy="0.01"
        iyz="0.0"
        izz="0.01"/>
    </inertial>

  </link>


  <!-- Attach the base to the world -->

  <joint name="world_to_base" type="fixed">
    <parent link="world"/>
    <child link="base_link"/>
    <origin xyz="0 0 0"/>
  </joint>


  <!-- ========================================================= -->
  <!-- LINK 1                                                    -->
  <!-- ========================================================= -->

  <link name="link_1">

    <visual>
      <origin xyz="0 0 0.10"/>
      <geometry>
        <box size="0.08 0.08 0.20"/>
      </geometry>
      <material name="link1_color">
        <color rgba="0.8 0.2 0.2 1"/>
      </material>
    </visual>

    <collision>
      <origin xyz="0 0 0.10"/>
      <geometry>
        <box size="0.08 0.08 0.20"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0.10"/>
      <mass value="1.0"/>
      <inertia
        ixx="0.005"
        ixy="0"
        ixz="0"
        iyy="0.005"
        iyz="0"
        izz="0.005"/>
    </inertial>

  </link>


  <joint name="joint_1" type="revolute">

    <parent link="base_link"/>
    <child link="link_1"/>

    <origin xyz="0 0 0.10"/>

    <axis xyz="0 0 1"/>

    <limit
      lower="-3.14"
      upper="3.14"
      effort="50"
      velocity="2.0"/>

    <dynamics damping="0.2"/>

  </joint>


  <!-- ========================================================= -->
  <!-- LINK 2                                                    -->
  <!-- ========================================================= -->

  <link name="link_2">

    <visual>
      <origin xyz="0.15 0 0"/>
      <geometry>
        <box size="0.30 0.07 0.07"/>
      </geometry>
      <material name="link2_color">
        <color rgba="0.2 0.6 0.9 1"/>
      </material>
    </visual>

    <collision>
      <origin xyz="0.15 0 0"/>
      <geometry>
        <box size="0.30 0.07 0.07"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0.15 0 0"/>
      <mass value="0.8"/>
      <inertia
        ixx="0.004"
        ixy="0"
        ixz="0"
        iyy="0.008"
        iyz="0"
        izz="0.008"/>
    </inertial>

  </link>


  <joint name="joint_2" type="revolute">

    <parent link="link_1"/>
    <child link="link_2"/>

    <origin xyz="0 0 0.20"/>

    <axis xyz="0 1 0"/>

    <limit
      lower="-1.57"
      upper="1.57"
      effort="50"
      velocity="2.0"/>

    <dynamics damping="0.2"/>

  </joint>


  <!-- ========================================================= -->
  <!-- LINK 3                                                    -->
  <!-- ========================================================= -->

  <link name="link_3">

    <visual>
      <origin xyz="0.125 0 0"/>
      <geometry>
        <box size="0.25 0.06 0.06"/>
      </geometry>
      <material name="link3_color">
        <color rgba="0.2 0.8 0.4 1"/>
      </material>
    </visual>

    <collision>
      <origin xyz="0.125 0 0"/>
      <geometry>
        <box size="0.25 0.06 0.06"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0.125 0 0"/>
      <mass value="0.6"/>
      <inertia
        ixx="0.003"
        ixy="0"
        ixz="0"
        iyy="0.006"
        iyz="0"
        izz="0.006"/>
    </inertial>

  </link>


  <joint name="joint_3" type="revolute">

    <parent link="link_2"/>
    <child link="link_3"/>

    <origin xyz="0.30 0 0"/>

    <axis xyz="0 1 0"/>

    <limit
      lower="-2.20"
      upper="2.20"
      effort="40"
      velocity="2.0"/>

    <dynamics damping="0.2"/>

  </joint>


  <!-- ========================================================= -->
  <!-- LINK 4                                                    -->
  <!-- ========================================================= -->

  <link name="link_4">

    <visual>
      <origin xyz="0.075 0 0"/>
      <geometry>
        <box size="0.15 0.055 0.055"/>
      </geometry>
      <material name="link4_color">
        <color rgba="0.9 0.7 0.2 1"/>
      </material>
    </visual>

    <collision>
      <origin xyz="0.075 0 0"/>
      <geometry>
        <box size="0.15 0.055 0.055"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0.075 0 0"/>
      <mass value="0.4"/>
      <inertia
        ixx="0.002"
        ixy="0"
        ixz="0"
        iyy="0.003"
        iyz="0"
        izz="0.003"/>
    </inertial>

  </link>


  <joint name="joint_4" type="revolute">

    <parent link="link_3"/>
    <child link="link_4"/>

    <origin xyz="0.25 0 0"/>

    <axis xyz="1 0 0"/>

    <limit
      lower="-3.14"
      upper="3.14"
      effort="30"
      velocity="2.5"/>

    <dynamics damping="0.15"/>

  </joint>


  <!-- ========================================================= -->
  <!-- LINK 5                                                    -->
  <!-- ========================================================= -->

  <link name="link_5">

    <visual>
      <origin xyz="0.06 0 0"/>
      <geometry>
        <box size="0.12 0.05 0.05"/>
      </geometry>
      <material name="link5_color">
        <color rgba="0.7 0.3 0.8 1"/>
      </material>
    </visual>

    <collision>
      <origin xyz="0.06 0 0"/>
      <geometry>
        <box size="0.12 0.05 0.05"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0.06 0 0"/>
      <mass value="0.3"/>
      <inertia
        ixx="0.001"
        ixy="0"
        ixz="0"
        iyy="0.002"
        iyz="0"
        izz="0.002"/>
    </inertial>

  </link>


  <joint name="joint_5" type="revolute">

    <parent link="link_4"/>
    <child link="link_5"/>

    <origin xyz="0.15 0 0"/>

    <axis xyz="0 1 0"/>

    <limit
      lower="-2.0"
      upper="2.0"
      effort="25"
      velocity="2.5"/>

    <dynamics damping="0.15"/>

  </joint>


  <!-- ========================================================= -->
  <!-- LINK 6                                                    -->
  <!-- ========================================================= -->

  <link name="link_6">

    <visual>
      <origin xyz="0.05 0 0"/>
      <geometry>
        <box size="0.10 0.045 0.045"/>
      </geometry>
      <material name="link6_color">
        <color rgba="0.3 0.8 0.8 1"/>
      </material>
    </visual>

    <collision>
      <origin xyz="0.05 0 0"/>
      <geometry>
        <box size="0.10 0.045 0.045"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0.05 0 0"/>
      <mass value="0.2"/>
      <inertia
        ixx="0.001"
        ixy="0"
        ixz="0"
        iyy="0.0015"
        iyz="0"
        izz="0.0015"/>
    </inertial>

  </link>


  <joint name="joint_6" type="revolute">

    <parent link="link_5"/>
    <child link="link_6"/>

    <origin xyz="0.12 0 0"/>

    <axis xyz="1 0 0"/>

    <limit
      lower="-3.14"
      upper="3.14"
      effort="20"
      velocity="3.0"/>

    <dynamics damping="0.1"/>

  </joint>


  <!-- ========================================================= -->
  <!-- END EFFECTOR                                              -->
  <!-- ========================================================= -->

  <link name="tool_link">

    <visual>
      <geometry>
        <sphere radius="0.035"/>
      </geometry>
      <material name="tool_color">
        <color rgba="1 0.4 0.1 1"/>
      </material>
    </visual>

    <collision>
      <geometry>
        <sphere radius="0.035"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="0.1"/>
      <inertia
        ixx="0.0001"
        ixy="0"
        ixz="0"
        iyy="0.0001"
        iyz="0"
        izz="0.0001"/>
    </inertial>

  </link>


  <joint name="tool_joint" type="fixed">

    <parent link="link_6"/>
    <child link="tool_link"/>

    <origin xyz="0.10 0 0"/>

  </joint>


  <!-- ========================================================= -->
  <!-- ROS 2 CONTROL                                             -->
  <!-- ========================================================= -->

  <ros2_control
    name="GazeboSimSystem"
    type="system">

    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>


    <joint name="joint_1">

      <command_interface name="position">
        <param name="min">-3.14</param>
        <param name="max">3.14</param>
      </command_interface>

      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>

      <state_interface name="velocity"/>

    </joint>


    <joint name="joint_2">

      <command_interface name="position">
        <param name="min">-1.57</param>
        <param name="max">1.57</param>
      </command_interface>

      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>

      <state_interface name="velocity"/>

    </joint>


    <joint name="joint_3">

      <command_interface name="position">
        <param name="min">-2.20</param>
        <param name="max">2.20</param>
      </command_interface>

      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>

      <state_interface name="velocity"/>

    </joint>


    <joint name="joint_4">

      <command_interface name="position">
        <param name="min">-3.14</param>
        <param name="max">3.14</param>
      </command_interface>

      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>

      <state_interface name="velocity"/>

    </joint>


    <joint name="joint_5">

      <command_interface name="position">
        <param name="min">-2.0</param>
        <param name="max">2.0</param>
      </command_interface>

      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>

      <state_interface name="velocity"/>

    </joint>


    <joint name="joint_6">

      <command_interface name="position">
        <param name="min">-3.14</param>
        <param name="max">3.14</param>
      </command_interface>

      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>

      <state_interface name="velocity"/>

    </joint>

  </ros2_control>


  <!-- Gazebo plugin that connects Gazebo to ros2_control -->

  <gazebo>

    <plugin
      filename="libgz_ros2_control-system.so"
      name="gz_ros2_control::GazeboSimROS2ControlPlugin">

      <parameters>$(arg controller_yaml)</parameters>

    </plugin>

  </gazebo>


</robot>
